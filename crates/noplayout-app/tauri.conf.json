{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noPlayout",
  "identifier": "org.noplayout.app",
  "build": {
    "frontendDist": "../../web/dist/ui"
  },
  "app": {
    "windows": [
      {
        "title": "noPlayout",
        "width": 720,
        "height": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
