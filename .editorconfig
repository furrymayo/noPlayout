root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,txt}]
trim_trailing_whitespace = false

[*.{js,mjs,ts,svelte,json,html,css,yml,yaml,toml}]
indent_size = 2

[Cargo.toml]
indent_size = 4

# Fixtures are byte-identical copies of supplied material; never reformat them.
[fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
